{
  "name": "ai-usage-widget",
  "version": "2.0.0",
  "description": "Private desktop widget for Claude and Codex subscription usage",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "lint": "node scripts/check-syntax.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:mac": "electron-builder --mac dmg --arm64",
    "build:mac:unpacked": "electron-builder --mac dir --arm64",
    "build:mac:universal": "electron-builder --mac dmg --universal",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "claude",
    "codex",
    "openai",
    "usage",
    "widget",
    "electron"
  ],
  "author": "James Han; based on Claude Usage Widget by Slavomir Durej",
  "license": "MIT",
  "copyright": "Copyright © 2025 Slavomir Durej; modifications © 2026 James Han",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "cross-env": "^7.0.3",
    "electron": "41.10.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.jameshan.aiusagewidget",
    "productName": "AI Usage Widget",
    "copyright": "Copyright © 2025 Slavomir Durej; modifications © 2026 James Han",
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-portable.${ext}",
      "unpackDirName": "ai-usage-widget"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-win-Setup.${ext}"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.md"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2025 Slavomir Durej; modifications © 2026 James Han"
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macOS-${arch}.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/logo.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
